# Notion API Configuration
# Get your API token from: https://www.notion.so/my-integrations
# Trades database ID from URL: https://www.notion.so/{DATABASE_ID}?v=...

# Optional speech model override (default is full model: vosk-model-en-us-0.22)
VOSK_MODEL_NAME=vosk-model-en-us-0.22

NOTION_API_TOKEN=ntn_your_api_token_here
NOTION_TRADES_DATABASE_ID=26fc63a3815e8108bbafdf6bd8bc7d4c

# Optional trade defaults (used when not specified via voice)
TRADE_SYMBOL=
TRADE_ACCOUNT=
TRADE_MODEL=
TRADE_SESSION=
